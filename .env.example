# ══════════════════════════════════════════════
# Julia — Configuration (copie ce fichier en .env)
# NE JAMAIS partager ce fichier une fois rempli
# ══════════════════════════════════════════════

# --- Cerveau IA (Mistral = cerveau principal, Gemini = vision) ---
MISTRAL_API_KEY=colle_ta_cle_mistral_ici
GEMINI_API_KEY=colle_ta_cle_gemini_ici

# --- OSINT ---
SHODAN_API_KEY=colle_ta_cle_shodan_ici

# --- Numéro autorisé à parler à Julia en PV (le tien) ---
# Format international sans le + , ex: 224xxxxxxxxx
JULIA_OWNER_NUMBER=224xxxxxxxxx

# --- Token pour accéder à l'interface web Jarvis ---
# Choisis un mot de passe long et unique, ex: genère-le sur bitwarden.com/password-generator
JULIA_WEB_TOKEN=change_moi_par_un_token_long_et_unique

# --- Ports internes (ne pas toucher sauf conflit) ---
WA_BRIDGE_PORT=4000
BRAIN_PORT=4001

# --- Base de données (XAMPP / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=julia
